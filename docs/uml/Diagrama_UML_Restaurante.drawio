        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\nclass Restaurante {\n    -String nombre\n    -Producto[] productos\n    -Mesa[] mesas\n    -Pedido[] pedidos\n    -int cantidadProductos\n    -int cantidadMesas\n    -int cantidadPedidos\n    +Restaurante(String nombre)\n    +getNombre() String\n    +setNombre(String nombre) void\n    +registrarProducto(Producto producto) String\n    +registrarMesa(Mesa mesa) String\n    +registrarPedido(Pedido pedido) String\n    +mostrarCatalogo() void\n    +mostrarMesas() void\n    +mostrarPedidos() void\n    +imprimirRecibo(Pedido pedido, ImpresoraRecibos impresora) void\n}\n\nclass Producto {\n    -int codigo\n    -String nombre\n    -double precio\n    +Producto(int codigo, String nombre, double precio)\n    +getCodigo() int\n    +getNombre() String\n    +getPrecio() double\n    +setCodigo(int codigo) void\n    +setNombre(String nombre) void\n    +setPrecio(double precio) void\n    +toString() String\n}\n\nclass Mesa {\n    -int numero\n    -boolean ocupada\n    +Mesa(int numero)\n    +getNumero() int\n    +getOcupada() boolean\n    +setNumero(int numero) void\n    +ocuparMesa() void\n    +liberarMesa() void\n    +toString() String\n}\n\nclass Pedido {\n    -int numero\n    -Mesa mesa\n    -DetallePedido[] detalles\n    -int cantidadDetalles\n    +Pedido(int numero, Mesa mesa)\n    +getNumero() int\n    +getMesa() Mesa\n    +getCantidadDetalles() int\n    +agregarProducto(Producto producto, int cantidad) String\n    +calcularTotal() double\n    +mostrarPedido() void\n}\n\nclass DetallePedido {\n    -Producto producto\n    -int cantidad\n    +DetallePedido(Producto producto, int cantidad)\n    +getProducto() Producto\n    +getCantidad() int\n    +calcularSubtotal() double\n    +toString() String\n}\n\nclass ImpresoraRecibos {\n    +imprimirPedido(Pedido pedido) void\n}\n\nRestaurante \&quot;1\&quot; o-- \&quot;0..10\&quot; Producto : registra\nRestaurante \&quot;1\&quot; o-- \&quot;0..10\&quot; Mesa : registra\nRestaurante \&quot;1\&quot; o-- \&quot;0..10\&quot; Pedido : registra\n\nPedido \&quot;1\&quot; *-- \&quot;0..10\&quot; DetallePedido : contiene\n\nPedido \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Mesa : asociacion\nDetallePedido \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Producto : asociacion\n\nRestaurante ..&gt; ImpresoraRecibos : utiliza\nImpresoraRecibos ..&gt; Pedido : imprime\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="vtD1MbGb7RWJyjQbYjYl-5">
